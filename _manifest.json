{
  "manifest_version": 2,
  "id": "github.winincorce-a11y.mai-jmcomic",
  "version": "1.5.4",
  "name": "JMComic 下载",
  "description": "把 JMComic-Crawler-Python 接进 MaiBot：按车号搜索、查看详情、下载本子并发送到群聊，支持每日配额、并发限制和任务取消。",
  "author": {
    "name": "winincorce-a11y",
    "url": "https://github.com/winincorce-a11y"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/winincorce-a11y/mai-jmcomic",
    "homepage": "https://github.com/winincorce-a11y/mai-jmcomic",
    "documentation": "https://github.com/winincorce-a11y/mai-jmcomic/blob/main/README.md",
    "issues": "https://github.com/winincorce-a11y/mai-jmcomic/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.7,<3"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "book-open",
      "fallback": "book",
      "background": "#1f2937"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "changelog": "CHANGELOG.md"
}
